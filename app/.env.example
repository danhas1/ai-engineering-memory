# ──────────────────────────────────────────────────────────────────────────
# Engineering Memory Assistant — environment variable reference
#
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed to source control.
# ──────────────────────────────────────────────────────────────────────────

# ── AWS credentials (local development only) ──────────────────────────────
# On EC2 with an IAM instance role these variables are NOT needed — the AWS
# SDK automatically discovers credentials from the instance metadata service.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── AWS region ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Amazon Bedrock Knowledge Base ─────────────────────────────────────────
KNOWLEDGE_BASE_ID=HGUEY0A2WY

# ── S3 bucket (required for the ingest.py ingestion script) ───────────────
# The S3 bucket that backs the Bedrock Knowledge Base data source.
# Used by app/ingest.py to upload documents and companion metadata files.
S3_BUCKET=your-knowledge-base-bucket-name
S3_PREFIX=knowledge_base

# ── Bedrock Agent ─────────────────────────────────────────────────────────────
# The Agent ID and alias to invoke. TSTALIASID is the built-in draft alias;
# create a named production alias in the Bedrock console for stable deployments.
BEDROCK_AGENT_ID=EGWXK2BGD9
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# ── Generation model ──────────────────────────────────────────────────────
# The ARN of the Bedrock inference profile used to generate answers from the
# retrieved documents.  Claude 3.5+ and Claude 4.x require a cross-region
# inference profile (the "us." prefix).  Direct foundation-model ARNs are
# rejected with ValidationException for these model generations.
#
# US cross-region inference profile examples (us-east-1 / us-east-2 / us-west-2):
#   Claude Sonnet 4.5 → arn:aws:bedrock:us-east-1::inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   Claude Haiku 4.5  → arn:aws:bedrock:us-east-1::inference-profile/us.anthropic.claude-haiku-4-5-20251001:0
#   Claude Opus 4.8   → arn:aws:bedrock:us-east-1::inference-profile/us.anthropic.claude-opus-4-8-20250514-v1:0
MODEL_ARN=arn:aws:bedrock:us-east-1::inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ── Flask ─────────────────────────────────────────────────────────────────
# Set to true only in local development; never in production.
FLASK_DEBUG=false
